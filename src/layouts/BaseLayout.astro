---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  pathname?: string;
  image?: string;
  bodyClass?: string;
}
const {
  locale,
  title,
  description,
  pathname = Astro.url.pathname,
  image,
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : locale} class={bodyClass}>
  <head>
    <BaseHead
      title={title}
      description={description}
      pathname={pathname}
      locale={locale}
      image={image}
    />
  </head>
  <body>
    <Header locale={locale} pathname={pathname} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} pathname={pathname} />

    <!-- 移动端底部固定栏：电话 / 在线咨询 -->
    <div class="mbar">
      <a class="call" href={`tel:${SITE.phone}`} aria-label={locale === 'zh' ? '电话' : locale === 'es' ? 'Llamar' : 'Call'}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {locale === 'zh' ? '电话' : locale === 'es' ? 'Llamar' : 'Call'}
      </a>
      <a class="cons" href={locale === 'en' ? '/contact/' : `/${locale}/contact/`} aria-label={locale === 'zh' ? '咨询' : locale === 'es' ? 'Consulta' : 'Enquiry'}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        {locale === 'zh' ? '咨询' : locale === 'es' ? 'Consultar' : 'Enquire'}
      </a>
    </div>

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
