---
import { SITE } from '../../consts';
const endpoint = `${SITE.formEndpoint}/api/translate`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Google 翻译助手 · Karfanjara Hilux</title>
    <style>
      :root { color-scheme: light; font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; background:#f5f1ea; color:#17202a; }
      body { margin:0; min-height:100vh; display:grid; place-items:center; padding:24px; box-sizing:border-box; }
      main { width:min(960px,100%); background:#fff; border:1px solid #ded6ca; border-radius:16px; padding:clamp(22px,4vw,42px); box-shadow:0 18px 55px rgba(37,43,50,.1); }
      h1 { margin:0 0 8px; font-size:clamp(26px,4vw,40px); letter-spacing:-.04em; }
      .muted { color:#68727c; margin:0 0 26px; line-height:1.65; }
      .grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
      label { display:flex; flex-direction:column; gap:7px; font-weight:700; font-size:13px; }
      select, textarea, input { box-sizing:border-box; width:100%; border:1px solid #d8d0c4; border-radius:8px; background:#fff; padding:11px 12px; font:inherit; color:inherit; }
      textarea { min-height:250px; resize:vertical; line-height:1.65; }
      .actions { display:flex; gap:10px; flex-wrap:wrap; margin:18px 0; }
      button, .back { border:0; border-radius:999px; padding:11px 17px; font-weight:700; cursor:pointer; text-decoration:none; }
      button[type=submit] { background:#243447; color:#fff; } button.secondary { background:#eee7dc; color:#243447; } .back { background:transparent; color:#68727c; border:1px solid #d8d0c4; }
      #status { min-height:22px; color:#68727c; font-size:14px; } .error { color:#b42318 !important; } .ok { color:#087443 !important; }
      @media(max-width:700px) { .grid { grid-template-columns:1fr; } textarea { min-height:180px; } }
    </style>
  </head>
  <body>
    <main>
      <h1>Google 翻译助手</h1>
      <p class="muted">在 CMS 编辑文章、产品或首页文案时，把源文案粘贴到左侧，生成译文后复制到对应语言字段。翻译请求经过 Worker，Google API 密钥不会暴露在浏览器。</p>
      <form id="translator">
        <div class="grid">
          <label>源语言
            <select name="source"><option value="zh">中文</option><option value="en">English</option><option value="es">Español</option></select>
          </label>
          <label>目标语言
            <select name="target"><option value="en">English</option><option value="zh">中文</option><option value="es">Español</option></select>
          </label>
          <label>源文案
            <textarea name="text" required placeholder="粘贴需要翻译的标题、摘要或正文…"></textarea>
          </label>
          <label>译文
            <textarea name="result" readonly placeholder="翻译结果会显示在这里"></textarea>
          </label>
        </div>
        <div class="actions"><button type="submit">自动翻译</button><button type="button" class="secondary" id="copy">复制译文</button><a class="back" href="/admin/">返回 CMS</a></div>
        <div id="status" role="status"></div>
      </form>
    </main>
    <script is:inline define:vars={{ endpoint }}>
      const form = document.getElementById('translator');
      const status = document.getElementById('status');
      const result = form.elements.result;
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.className = ''; status.textContent = '翻译中…';
        try {
          const body = Object.fromEntries(new FormData(form).entries());
          const response = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          const data = await response.json();
          if (!response.ok || !data.ok) throw new Error(data.error || '翻译失败');
          result.value = data.translatedText || '';
          status.className = 'ok'; status.textContent = '翻译完成，可以复制到 CMS 的目标语言字段。';
        } catch (error) { status.className = 'error'; status.textContent = error.message || '翻译失败，请检查 Worker 配置。'; }
      });
      document.getElementById('copy').addEventListener('click', async () => { if (!result.value) return; await navigator.clipboard.writeText(result.value); status.className = 'ok'; status.textContent = '已复制译文。'; });
    </script>
  </body>
</html>
