---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleDetail from '../../../components/ArticleDetail.astro';
import { getArticles, getArticle, relatedArticles } from '../../../lib/content';
import type { Locale } from '../../../i18n/ui';

const locale: Locale = 'es';
export async function getStaticPaths() {
  const articles = await getArticles('zh');
  return articles.map((a) => ({ params: { slug: a.id.replace(/(?:en|es)$/, '') }, props: { id: a.id.replace(/(?:en|es)$/, '') } }));
}
const { id } = Astro.props;
const entry = await getArticle(id, locale);
if (!entry) return Astro.redirect('/es/articles/');
const related = relatedArticles(entry, await getArticles(locale), 3);
---

<BaseLayout locale={locale} title={`${entry.data.title} | Karfanjara Hilux`} description={entry.data.excerpt} pathname={`/es/articles/${id}/`} bodyClass="solid-hdr">
  <ArticleDetail locale={locale} entry={entry} related={related} />
</BaseLayout>
