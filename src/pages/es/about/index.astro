---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WhyGrid from '../../../components/WhyGrid.astro';
import StatsBand from '../../../components/StatsBand.astro';
import Process from '../../../components/Process.astro';
import { useTranslations } from '../../../i18n/utils';
import { asset } from '../../../consts';
const locale = 'es';
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title="Sobre nosotros | Karfanjara Hilux" description="Desde 2005 fabricamos y entregamos sistemas de ventanas de aluminio y vidrio arquitectónico con estándar europeo." pathname="/es/about/" bodyClass="solid-hdr">
  <section class="ihero on-dark"><div class="ihero-bg"><img src={asset('/images/about-cover.svg')} alt="" /></div><div class="wrap ihero-inner"><div class="breadcrumb"><a href="/es/">Inicio</a> / Sobre nosotros</div><h1>Sobre nosotros</h1><p class="lead">Desde 2005 fabricamos y entregamos sistemas de ventanas de aluminio y vidrio arquitectónico con estándar europeo.</p></div></section>
  <section class="bp" style="padding-top:clamp(56px,8vw,96px);padding-bottom:0"><div class="wrap section-intro"><span class="eyebrow">{t('intro.eyebrow')}</span><h2 class="sec-title" set:html={t('intro.big')}></h2><p class="sec-sub" style="margin-top:18px">Entregamos sistemas que resisten el tiempo y el clima, con perfiles de fábrica, equipos locales de instalación y 15 años de garantía.</p></div></section>
  <WhyGrid locale={locale} /><StatsBand locale={locale} /><Process locale={locale} />
</BaseLayout>
