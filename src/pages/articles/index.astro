---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../lib/content';
import { useTranslations } from '../../i18n/utils';
import { asset } from '../../consts';
const locale = 'en';
const t = useTranslations(locale);
const articles = await getArticles(locale);
---

<BaseLayout
  locale={locale}
  title="News | Karfanjara Hilux"
  description="Company news, industry updates and media coverage."
  pathname="/articles/"
  bodyClass="solid-hdr"
>
  <section class="ihero on-dark">
    <div class="ihero-bg"><img src={asset('/images/articles-cover.svg')} alt="" /></div>
    <div class="wrap ihero-inner">
      <div class="breadcrumb"><a href="/">Home</a> / News</div>
      <h1>News</h1>
      <p class="lead">Company news, industry updates and media coverage.</p>
    </div>
  </section>

  <section style="background:var(--paper);padding:clamp(44px,6vw,72px) 0 clamp(72px,10vw,120px)">
    <div class="wrap">
      {articles.length === 0 ? (
        <p style="color:var(--text-soft)">No content yet. Please publish articles in Decap CMS admin.</p>
      ) : (
        <div class="blog-list">
          {articles.map((a) => <ArticleCard locale={locale} entry={a} />)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
