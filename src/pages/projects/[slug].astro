---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { getProject } from '../../lib/content';
import { useTranslations, type Locale } from '../../i18n/utils';

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const all = await getCollection('projects');
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { locale: 'en' as Locale, id: entry.id },
  }));
}

const { locale, id } = Astro.props;
const t = useTranslations(locale);
const entry = await getProject(id);
if (!entry) return Astro.redirect('/projects/');
const p = (s: string) => s;
---

<BaseLayout
  locale={locale}
  title={`${entry.data.titleEn || entry.data.title} | Karfanjara Hilux`}
  description={entry.data.excerptEn || entry.data.excerpt}
  pathname={p(`/projects/${id}/`)}
  bodyClass="solid-hdr"
>
  <ProjectDetail locale={locale} entry={entry} />
</BaseLayout>
