---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';
import { asset } from '../../consts';
const locale = 'en';
const projects = await getProjects(locale);
---

<BaseLayout
  locale={locale}
  title="Projects | Karfanjara Hilux"
  description="Real delivery cases for residential, office and commercial spaces."
  pathname="/projects/"
  bodyClass="solid-hdr"
>
  <section class="ihero on-dark">
    <div class="ihero-bg"><img src={asset('/images/projects-cover.svg')} alt="" /></div>
    <div class="wrap ihero-inner">
      <div class="breadcrumb"><a href="/">Home</a> / Projects</div>
      <h1>Projects</h1>
      <p class="lead">Real delivery cases for residential, office and commercial spaces.</p>
    </div>
  </section>

  <section style="background:var(--paper);padding:clamp(44px,6vw,72px) 0 clamp(72px,10vw,120px)">
    <div class="wrap">
      {projects.length === 0 ? (
        <p style="color:var(--text-soft)">No content yet. Please publish project cases in Decap CMS admin.</p>
      ) : (
        <div class="blog-list">
          {projects.map((pr) => <ProjectCard locale={locale} entry={pr} />)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
