---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { getProjects } from '../../../lib/content';
import { asset } from '../../../consts';
const locale = 'zh';
const projects = await getProjects(locale);
---

<BaseLayout
  locale={locale}
  title="项目案例 | Karfanjara Hilux"
  description="住宅、办公楼宇与商业空间的真实交付案例。"
  pathname="/zh/projects/"
  bodyClass="solid-hdr"
>
  <section class="ihero on-dark">
    <div class="ihero-bg"><img src={asset('/images/projects-cover.svg')} alt="" /></div>
    <div class="wrap ihero-inner">
      <div class="breadcrumb"><a href="/zh/">首页</a> / 项目案例</div>
      <h1>项目案例</h1>
      <p class="lead">住宅、办公楼宇与商业空间的真实交付现场。</p>
    </div>
  </section>

  <section style="background:var(--paper);padding:clamp(44px,6vw,72px) 0 clamp(72px,10vw,120px)">
    <div class="wrap">
      {projects.length === 0 ? (
        <p style="color:var(--text-soft)">暂无内容，请在 Decap CMS 后台发布项目案例。</p>
      ) : (
        <div class="blog-list">
          {projects.map((pr) => <ProjectCard locale={locale} entry={pr} />)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>